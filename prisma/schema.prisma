generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
enum LibraryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  PLAYER
  MCQ
}
enum CourseAccess {
  OPEN
  MEMBERS
  SUBSCRIPTION
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("student")
  resource String?
  createdAt DateTime @default(now())

  subscriptions  Subscription[]
  communications Communication[]
}
model Admin {
  id        Int      @id @default(autoincrement())

  email     String   @unique
  password  String

  name      String?

  resource  String

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Course {
 
  id          Int @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String?
  thumbnail   String?

  access  CourseAccess @default(OPEN)

  price Int @default(0)

  library       Library[]
  subscriptions Subscription[]
}

model Library {
  id Int @id @default(autoincrement())

  slug String @unique

  title String

  description String?

  thumbnail String?


  type ContentType

  body String?

  courseId Int
  sortOrder Int @default(0)
  allowCommunication Boolean @default(true)
  status      LibraryStatus  @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course         Course          @relation(fields: [courseId], references: [id])

  @@index([slug])
  @@index([courseId])
}

model Subscription {
  id Int @id @default(autoincrement())

  userId   Int
  courseId Int

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
}

model Communication {
  id Int @id @default(autoincrement())

  userId Int

  referenceId String

  type String
  
  meta String?

  message String

  authorResponse String?

  isPublic Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
}
