<!DOCTYPE html>
<html lang="en">

<head>

	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<title>Taleem Admin Login</title>

	<style>

		body {
			font-family: sans-serif;
			max-width: 420px;
			margin: 50px auto;
			padding: 20px;
		}

		h1 {
			margin-bottom: 24px;
		}

		label {
			display: block;
			margin-top: 16px;
			margin-bottom: 6px;
			font-weight: bold;
		}

		input {
			width: 100%;
			padding: 10px;
			box-sizing: border-box;
		}

		button {
			margin-top: 24px;
			padding: 10px 18px;
			cursor: pointer;
		}

		#error {
			color: crimson;
			margin-top: 16px;
		}

	</style>

</head>

<body>

	<h1>Taleem Admin Login</h1>

	<form id="loginForm">

		<label>Email</label>
		<input
			type="email"
			name="email"
			required
		/>

		<label>Password</label>
		<input
			type="password"
			name="password"
			required
		/>

		<button type="submit">
			Login
		</button>

	</form>

	<div id="error"></div>

	<script>

		const form = document.getElementById("loginForm");
		const error = document.getElementById("error");

		form.addEventListener("submit", async (event) => {

			event.preventDefault();

			error.textContent = "";

			const email = form.email.value;
			const password = form.password.value;

			const response = await fetch("/api/admin/login", {

				method: "POST",

				headers: {
					"Content-Type": "application/json"
				},

				body: JSON.stringify({
					email,
					password
				})

			});

			const data = await response.json();

			if (!response.ok) {

				error.textContent =
					data.message || "Login failed.";

				return;

			}

			localStorage.setItem(
				"taleem-email",
				email
			);

			localStorage.setItem(
				"taleem-token",
				data.token
			);

			window.location =
				"/api/views/library";

		});

	</script>

</body>

</html>